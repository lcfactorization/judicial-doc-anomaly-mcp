# .gitignore for judicial-lint-mcp

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
!.env.example

# Cache
.judicial_lint_cache/
.cache/

# Output (generated reports, NOT documentation)
output/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Generated reports (may contain case data)
*检测报告*.md
*检测报告*.json
test_cases/*/full_report.md
test_cases/*/evidence_result.md

# Graphify cache (LLM response cache, may contain case data)
graphify-out/

# Sensitive: run_detection.py contains real case data (names, case numbers, etc.)
run_detection.py

# Sensitive: generated reports may contain PII
reports/
*.检测报告*.html
