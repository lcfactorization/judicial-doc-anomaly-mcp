# ======================================
# judicial-lint-mcp v0.5.0 — 配置文件
# ======================================
# 
# ⚠️ v0.5.0 重大变更：MCP Server 不再调用任何 LLM
#    LLM_API_KEY 等配置在本版本中不再使用
#    所有 LLM 调用由 AI Agent 自行管理
#
# 如需在 CLI 模式下直接调用 LLM（兼容旧版功能），
# 可保留以下配置。否则建议删除此文件。

# LLM API 配置（仅 CLI 直接调用 LLM 时需要）
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=120

# 日志
VERBOSE=false