# LLM API 配置
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
# LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8000
LLM_TIMEOUT=120

# 检测配置
DETECTION_DIMENSIONS=procedure,evidence,fact_finding,law_application,discretion,logic,temporal,semantic_drift,negative_space,case_deviation,procedure_graph,coupling
ENABLE_ADVERSARIAL_CHECK=true
ENABLE_WEB_SEARCH=false

# 路径配置
CACHE_DIR=.judicial_lint_cache
OUTPUT_DIR=./output

# 日志
VERBOSE=false
